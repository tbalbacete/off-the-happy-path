---
import Stamp from './Stamp.astro';
import { site } from '../data/site';
import { formatEntryNo } from '../lib/entries';
import type { EntrySummary } from '../lib/home';

interface Props {
  entry: EntrySummary;
  /** Show the LATEST marker (the featured entry only). */
  latest?: boolean;
}

const { entry, latest = false } = Astro.props;
---

<div class="entry-meta">
  <span class="entry-meta__no">{formatEntryNo(entry.no)}</span>
  <time datetime={entry.date}>{entry.date}</time>
  <Stamp type={entry.type} />
  {latest && <span class="entry-meta__flag">{site.log.latest}</span>}
  {entry.draft && <span class="entry-meta__flag">{site.log.draft}</span>}
</div>

<style>
  .entry-meta {
    flex: 0 0 150px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--pencil);
  }
  .entry-meta__no {
    color: var(--ink);
    font-weight: 600;
    font-size: 13px;
  }
  .entry-meta__flag {
    margin-top: 6px;
    color: var(--pen);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .entry-meta__flag + .entry-meta__flag {
    margin-top: 0;
  }

  /* No room beside the content: lay the meta out in a line above it. */
  @media (max-width: 600px) {
    .entry-meta {
      flex: 1 1 100%;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 14px;
    }
    .entry-meta__flag {
      margin-top: 0;
    }
  }
</style>
