---
import { site } from '../data/site';

const [firstLine, secondLine] = site.nameLines;
---

<header class="masthead">
  <div class="masthead__title">
    <span class="label">{site.masthead.titleLabel}</span>
    <h1 class="masthead__name">
      <a href="/">{firstLine}<br />{secondLine}</a>
    </h1>
  </div>
  <dl class="masthead__cells">
    {
      site.masthead.cells.map((cell) => (
        <div class="masthead__cell">
          <dt class="label label--small">{cell.label}</dt>
          <dd>{cell.value}</dd>
        </div>
      ))
    }
  </dl>
</header>

<style>
  /* Form cells: an ink background showing through 2px gaps. */
  .masthead {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    background: var(--ink);
    border: 2px solid var(--ink);
  }
  .masthead__title {
    flex: 999 1 520px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--paper);
    padding: 18px 24px 26px;
  }
  .masthead__name {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 72%;
    font-weight: 900;
    font-size: clamp(48px, 14vw, 92px);
    line-height: 0.88;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .masthead__name a {
    color: inherit;
    text-decoration: none;
  }
  .masthead__cells {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
  }
  .masthead__cell {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--paper);
    padding: 10px 16px;
  }
  .masthead__cell dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .masthead__title {
      padding: 14px 16px 20px;
    }
  }
</style>
