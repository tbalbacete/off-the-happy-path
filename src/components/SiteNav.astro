---
import MainNav from './MainNav.astro';
import { site, type NavId } from '../data/site';

interface Props {
  /** The nav item for the current page, if any. */
  active?: NavId;
}

const { active } = Astro.props;
---

<div class="tagline-row">
  <p class="tagline">{site.tagline}</p>
  <MainNav active={active} />
</div>

<style>
  .tagline-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 32px;
    padding: 22px 0 20px;
    border-bottom: 1px solid var(--ink);
  }
  .tagline {
    margin: 0;
    max-width: 640px;
    font-style: italic;
    font-size: 21px;
    line-height: 1.45;
  }

  @media (max-width: 480px) {
    .tagline {
      font-size: 19px;
    }
  }
</style>
