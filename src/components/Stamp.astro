---
import type { PostType } from '../lib/home';

interface Props {
  type: PostType;
  /** The slightly larger stamp in a post's kicker. */
  large?: boolean;
}

const { type, large = false } = Astro.props;
---

<span class:list={['stamp', { 'stamp--pen': type === 'rant', 'stamp--large': large }]}>{type}</span>

<style>
  .stamp {
    align-self: flex-start;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    border: 1.5px solid var(--ink);
    padding: 2px 7px;
    transform: rotate(-2deg);
  }
  .stamp--large {
    font-size: 11px;
  }
  .stamp--pen {
    color: var(--pen);
    border-color: var(--pen);
  }
</style>
