---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Stamp from '../components/Stamp.astro';
import TitleBlock from '../components/TitleBlock.astro';
import PostMeta from '../components/PostMeta.astro';
import Footer from '../components/Footer.astro';
import { site, type NavId } from '../data/site';
import { formatEntryNo } from '../lib/entries';
import type { PostType } from '../lib/home';
import type { MetaRow } from '../lib/post';
import type { OgImage } from '../lib/meta';

interface Props {
  no: number;
  title: string;
  dek: string;
  type: PostType;
  date: string;
  /** The entry details column. */
  meta: MetaRow[];
  /** The main nav item to mark active. */
  active: NavId;
  /** The post's Open Graph card. */
  image: OgImage;
}

const { no, title, dek, type, date, meta, active, image } = Astro.props;
---

<BaseLayout title={title} description={dek} type="article" image={image}>
  <div class="container container--post">
    <SiteHeader active={active} />
    <main id="main" class="post">
      <TitleBlock title={title} dek={dek}>
        <Fragment slot="kicker">
          {formatEntryNo(no)} · <Stamp type={type} large /> · {site.post.filed}{' '}<time datetime={date}>{date}</time>
        </Fragment>
      </TitleBlock>
      <div class="post-columns">
        <PostMeta rows={meta} />
        <article class="post-body prose">
          <slot />
          <slot name="after" />
        </article>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .container--post {
    padding-top: 28px;
  }
  /*
   * Meta column, article, and an empty third track that the sidenotes float
   * into. Under the sidenote breakpoint the third track goes; on phones the
   * meta column moves above the article.
   */
  .post-columns {
    display: grid;
    grid-template-columns: 170px minmax(0, 660px) 200px;
    gap: 32px 48px;
    padding-top: 40px;
  }
  .post-body {
    min-width: 0;
  }
  .post + :global(.site-footer) {
    margin-top: 64px;
  }

  @media (max-width: 1099px) {
    .post-columns {
      grid-template-columns: 170px minmax(0, 660px);
    }
  }
  @media (max-width: 720px) {
    .post-columns {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 28px;
    }
  }
  @media (max-width: 480px) {
    .container--post {
      padding-top: 20px;
    }
  }
  /*
   * Print: the post on the page's own white. The title, the meta rows as one
   * compact block, the article and the end notes; no nav, reply box, share
   * box, previous/next or sidenotes. Long code lines wrap, external links
   * print their URLs, and code boxes and headings don't split across pages.
   */
  @media print {
    .container--post {
      max-width: none;
      padding: 0;
    }
    .container--post :global(.main-nav),
    .post :global(.reply),
    .post :global(.share),
    .post :global(.prev-next),
    .post-body :global(.sidenote) {
      display: none;
    }
    .container--post :global(.site-header) {
      padding-bottom: 6px;
    }
    .container--post :global(.site-header__name) {
      font-size: 16px;
    }
    .post :global(.title-block) {
      max-width: none;
      padding: 24px 0 16px;
    }
    .post :global(.title-block__title) {
      font-size: 40px;
    }
    .post :global(.title-block__dek) {
      font-size: 16px;
    }
    .post-columns {
      display: block;
      padding-top: 12px;
    }
    .post .post-columns :global(.post-meta dl) {
      display: flex;
      flex-wrap: wrap;
      gap: 0 28px;
      border-top: 0;
      font-size: 10px;
    }
    .post .post-columns :global(.post-meta__row) {
      padding: 4px 0;
      border-bottom: 0;
    }
    .post-body {
      margin-top: 20px;
      font-size: 12pt;
      line-height: 1.5;
    }
    .post-body :global(.footnotes) {
      display: block;
    }
    /* The 2px margin keeps the right border off the page's clip edge. */
    .post-body :global(.code-box) {
      margin-right: 2px;
      break-inside: avoid;
    }
    .post-body :global(.code-box pre) {
      overflow: visible;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .post-body :global(.code-box code) {
      width: auto;
    }
    /* Browsers drop backgrounds when printing; keep the highlighted line. */
    .post-body :global(.code-box .line.highlighted) {
      print-color-adjust: exact;
    }
    .post-body :global(h2),
    .post-body :global(h3) {
      break-after: avoid;
    }
    .post-body :global(a[href^='http'])::after {
      content: ' (' attr(href) ')';
      font-family: var(--font-mono);
      font-size: 0.75em;
      overflow-wrap: anywhere;
    }
    .post + :global(.site-footer) {
      margin-top: 24px;
    }
    .container--post :global(.site-footer span:last-child) {
      display: none;
    }
  }
</style>
