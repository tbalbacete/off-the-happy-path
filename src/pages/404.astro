---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';

const n = site.notFound;
---

<PageLayout title={n.title} metaTitle={n.metaTitle} kicker={n.kicker} dek={n.dek} active="writing" noindex>
  <ul class="not-found-links" aria-label={n.linksLabel}>
    {
      n.links.map((link) => (
        <li>
          <a href={link.href}>{link.label} →</a>
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  .not-found-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
