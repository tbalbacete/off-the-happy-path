---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import SiteNav from '../components/SiteNav.astro';
import LogHeader from '../components/LogHeader.astro';
import FeaturedEntry from '../components/FeaturedEntry.astro';
import EntryRow from '../components/EntryRow.astro';
import HomeAside from '../components/HomeAside.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getPosts } from '../lib/posts';
import { padEntryNo } from '../lib/entries';
import { entrySummary, homeEntries } from '../lib/home';
import { tagCounts } from '../lib/tags';

const posts = await getPosts();
const { featured, rows, older } = homeEntries(posts);
const tags = tagCounts(posts);
---

<BaseLayout>
  <div class="container">
    <Masthead />
    <SiteNav active="writing" />
    <div class="columns">
      <main id="main" class="log">
        <LogHeader active="all" />
        {featured ? <FeaturedEntry entry={entrySummary(featured)} /> : <p class="log-empty">{site.log.noEntries}</p>}
        {rows.map((post) => <EntryRow entry={entrySummary(post)} />)}
        {
          older && (
            <p class="older">
              <a href={site.log.olderHref}>
                {site.log.older} ({padEntryNo(older.from)}–{padEntryNo(older.to)}) →
              </a>
            </p>
          )
        }
      </main>
      <HomeAside tags={tags} />
    </div>
    <Footer />
  </div>
</BaseLayout>
