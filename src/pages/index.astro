---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { getPosts } from '../lib/posts';
import { formatEntryNo, slugFromId } from '../lib/entries';

const posts = await getPosts();
---

<BaseLayout>
  <div class="container">
    <Masthead />
    <SiteNav active="writing" />
    <main>
      <ul>
        {
          posts.map((post) => (
            <li>
              <span class="mono">{formatEntryNo(post.data.no)}</span>{' '}
              <span class="mono">{post.data.date}</span>{' '}
              <a href={`/log/${slugFromId(post.id)}/`}>{post.data.title}</a>
              {post.data.draft && <span class="mono"> (draft)</span>}
            </li>
          ))
        }
      </ul>
    </main>
    <Footer />
  </div>
</BaseLayout>
