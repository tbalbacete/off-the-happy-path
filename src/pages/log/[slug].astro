---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import ReplyBox from '../../components/ReplyBox.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getPosts, type Post } from '../../lib/posts';
import { slugFromId } from '../../lib/entries';
import { navItemForType } from '../../lib/home';
import { neighbourLink, postMeta, prevNext } from '../../lib/post';
import { readingTime } from '../../lib/reading-time';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: slugFromId(post.id) },
    props: { post, ...prevNext(posts, post.data.no) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  previous: Post | null;
  next: Post | null;
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
const { no, title, dek, type, date } = post.data;
const meta = postMeta(post, readingTime(post.body ?? ''));
---

<PostLayout no={no} title={title} dek={dek} type={type} date={date} meta={meta} active={navItemForType(type)}>
  <Content />
  <ReplyBox slot="after" no={no} />
  <PrevNext slot="after" previous={neighbourLink(previous)} next={neighbourLink(next)} />
</PostLayout>
