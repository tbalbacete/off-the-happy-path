---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import ReplyBox from '../../components/ReplyBox.astro';
import PrevNext from '../../components/PrevNext.astro';
import ShareBox from '../../components/ShareBox.astro';
import { getPosts, type Post } from '../../lib/posts';
import { postHref, slugFromId } from '../../lib/entries';
import { navItemForType } from '../../lib/home';
import { neighbourLink, postMeta, prevNext } from '../../lib/post';
import { canonicalUrl } from '../../lib/meta';
import { postCardPath, postOgImage } from '../../lib/og';
import { readingTime } from '../../lib/reading-time';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: slugFromId(post.id) },
    props: { post, ...prevNext(posts, post.data.no) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  previous: Post | null;
  next: Post | null;
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
const { no, title, dek, type, date, draft } = post.data;
const meta = postMeta(post, readingTime(post.body ?? ''));
if (!Astro.site) throw new Error('Set `site` in astro.config.mjs; the share box needs the canonical URL.');
const url = canonicalUrl(postHref(post.id), Astro.site);
const slug = slugFromId(post.id);
// The build runs from the repo root; the card is checked in under public/.
const hasCard = existsSync(join(process.cwd(), 'public', postCardPath(slug)));
const image = postOgImage({ slug, no, title, draft, hasCard, production: import.meta.env.PROD });
---

<PostLayout no={no} title={title} dek={dek} type={type} date={date} meta={meta} active={navItemForType(type)} image={image}>
  <Content />
  <ReplyBox slot="after" no={no} />
  <ShareBox slot="after" url={url} title={title} />
  <PrevNext slot="after" previous={neighbourLink(previous)} next={neighbourLink(next)} />
</PostLayout>
